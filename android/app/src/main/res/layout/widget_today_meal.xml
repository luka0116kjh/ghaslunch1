<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/today_meal_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_today_meal_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/today_meal_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_today_meal_title"
            android:textColor="#1C1C1E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/today_meal_widget_refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_refresh_background"
            android:gravity="center"
            android:text="@string/widget_today_meal_refresh"
            android:textColor="#2F8CFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/today_meal_widget_menu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:maxLines="4"
        android:text="@string/widget_today_meal_loading"
        android:textColor="#262626"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/today_meal_widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#747A82"
        android:textSize="11sp" />
</LinearLayout>
