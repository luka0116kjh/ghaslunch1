{
  "rules": {
    ".read": false,
    ".write": false,

    "stats": {
      "visitCount": {
        ".read": true,
        ".write": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() === 1) || (data.exists() && data.isNumber() && newData.val() === data.val() + 1))"
      },
      "$other": {
        ".read": false,
        ".write": false
      }
    },
    "tokens": {
      ".read": false,
      ".write": false
    },
    "notificationTokens": {
      ".read": false,
      ".write": false
    },
    "meals": {
      ".read": true,
      ".write": false
    },
    "timetable": {
      ".read": true,
      ".write": false
    },
    "notices": {
      ".read": true,
      ".write": false
    },
    "status": {
      ".read": false,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
