{
  "rules": {
    "stats": {
      "visitCount": {
        ".read": true,
        ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
      }
    },
    "tokens": {
      "$token_id": {
        ".read": false,
        ".write": "$token_id.matches(/^[0-9a-f]{64}$/) && (!newData.exists() || newData.hasChildren(['lastUpdated', 'platform']))",
        "lastUpdated": {
          ".validate": "newData.isNumber() || newData.val() == now"
        },
        "platform": {
          ".validate": "newData.val() === 'web'"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "status": {
      ".read": false,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
