rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 누적 방문자 카운터: 누구나 읽기 가능, 공개 쓰기는 count 를 정확히 +1 하는 경우만 허용.
    // 임의 값 설정/초기화/필드 추가를 막아 카운터 조작을 방지한다.
    match /stats/visitCount {
      allow read: if true;
      // 최초 baseline(count: 600) 문서 생성은 신뢰된 관리자(Admin SDK·Firebase 콘솔,
      // 보안 규칙 우회)만 수행한다. 공개 클라이언트가 카운터를 임의 값(예: 1)으로
      // 초기화해 baseline 을 덮어쓰지 못하도록 create 를 막는다.
      allow create: if false;
      // 공개 쓰기는 기존 count 를 정확히 +1 하는 경우만 허용한다 (예: 600 -> 601).
      allow update: if request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // 그 외 모든 문서는 기본 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
